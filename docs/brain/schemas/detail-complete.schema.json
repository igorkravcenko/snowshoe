{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snowshoe.dev/schemas/detail-complete.schema.json",
  "title": "Detail work-complete payload (inner)",
  "type": "object",
  "additionalProperties": false,
  "required": ["parentSlug", "nodes", "unchanged"],
  "properties": {
    "parentSlug": {
      "type": "string",
      "minLength": 1
    },
    "unchanged": {
      "type": "boolean"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "type", "op"],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["module", "surface", "flow", "symbol", "external"]
          },
          "op": {
            "type": "string",
            "enum": ["upsert"]
          },
          "leaf": {
            "type": "boolean"
          },
          "proseRef": {
            "type": "string"
          },
          "anchors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path"],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                },
                "symbol": {
                  "type": "string"
                },
                "startLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "endLine": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Inclusive end. Send only when known; omit rather than guess."
                }
              }
            }
          }
        }
      }
    },
    "children": {
      "type": "array",
      "description": "Parent→child slugs under parentSlug (hierarchy). Every nodes[].slug except parentSlug must appear here.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "refs": {
      "type": "array",
      "description": "Non-hierarchy relevance links between entities. kind must not be parent.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "retire": {
      "type": "array",
      "description": "Delete descendant slugs (not parentSlug, not root).",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "clearEdges": {
      "type": "array",
      "description": "Remove an edge. kind default related; parent only from parentSlug to a current child.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "description": "Inner completions[].payload when kind=detail. Outer envelope (id, leaseToken, kind) is the work-complete wrapper. Agent omits metrics. Missing/moved anchor paths hard-reject. Do not send edges; use children + refs. Optional retire / clearEdges stay in the parent subtree. parentSlug may appear in nodes (enrich); root may not. Util silently rejects forbidden node types."
}
