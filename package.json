{
  "name": "@igorkravcenko/snowshoe",
  "version": "0.0.2",
  "license": "Apache-2.0",
  "description": "Snowshoe — don't let your agents outrun your understanding. Keep your footing. A git-native personal comprehension map of a repository — tracks what goes stale after pull.",
  "keywords": [
    "cli",
    "git",
    "comprehension-map",
    "codebase",
    "agents",
    "bun",
    "snowshoe",
    "snoe"
  ],
  "type": "module",
  "bin": {
    "snowshoe": "./src/index.ts",
    "snoe": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "ui/dist",
    "skills/snowshoe",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorkravcenko/snowshoe.git"
  },
  "homepage": "https://github.com/igorkravcenko/snowshoe#readme",
  "bugs": {
    "url": "https://github.com/igorkravcenko/snowshoe/issues"
  },
  "scripts": {
    "snowshoe": "bun src/index.ts",
    "snoe": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check .",
    "build:ui": "vite build --config ui/vite.config.ts",
    "prepack": "bun run build:ui"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "citty": "^0.1.6",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.8.2",
    "vite": "^8.3.1"
  }
}
